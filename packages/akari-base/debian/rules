#!/usr/bin/make -f
B := debian/akari-base
%:
	dh $@

override_dh_auto_install:
	install -D -m 644 files/os-release $(B)/usr/lib/os-release
	install -D -m 644 files/issue $(B)/usr/lib/akari-base/issue
	install -D -m 644 files/getty-akari.conf $(B)/usr/lib/systemd/system/getty@.service.d/akari.conf
	install -D -m 644 files/serial-getty-akari.conf $(B)/usr/lib/systemd/system/serial-getty@.service.d/akari.conf
	install -D -m 644 files/origin $(B)/etc/dpkg/origins/akari
	install -D -m 644 files/grub.cfg $(B)/etc/default/grub.d/akari.cfg
	# GRUB's theme: the background from SVG, the fonts in GRUB's own format
	T=$(B)/usr/share/grub/themes/akari; install -d $$T && \
	  install -m 644 files/grub-theme/theme.txt $$T/ && \
	  rsvg-convert files/grub-theme/background.svg -o $$T/background.png && \
	  rsvg-convert files/grub-theme/select_c.svg -o $$T/select_c.png && \
	  D=/usr/share/fonts/truetype/dejavu && \
	  grub-mkfont -s 14 -o $$T/dejavu-sans-14.pf2 $$D/DejaVuSans.ttf && \
	  grub-mkfont -s 18 -o $$T/dejavu-sans-18.pf2 $$D/DejaVuSans.ttf && \
	  grub-mkfont -s 18 -o $$T/dejavu-sans-bold-18.pf2 $$D/DejaVuSans-Bold.ttf && \
	  grub-mkfont -s 16 -o $$T/dejavu-sans-mono-16.pf2 $$D/DejaVuSansMono.ttf
