#!/bin/sh
set -e
#DEBHELPER#
# ours is gone: Debian's comes back
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
	for f in /usr/lib/os-release; do
		dpkg-divert --package akari-base --rename --remove "$f" >/dev/null
	done
fi
# the getty drop-ins are gone: Debian's agetty again
if [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
fi
# GRUB as Debian left it
if { [ "$1" = remove ] || [ "$1" = purge ]; } && [ -x /usr/sbin/update-grub ] && [ -f /boot/grub/grub.cfg ]; then
	update-grub 2>/dev/null || true
fi
exit 0
